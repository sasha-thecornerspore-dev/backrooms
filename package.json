{
  "name": "backrooms",
  "version": "2.0.3",
  "description": "The Backrooms — infinite procedural horror maze",
  "author": "Corner Spore",
  "license": "MIT",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "dev.cornerspore.backrooms",
    "productName": "The Backrooms",
    "copyright": "Copyright © 2026 Corner Spore",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/build-config.json",
      "server/**/*",
      "!server/node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "The-Backrooms-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon-512.png",
      "category": "Game",
      "maintainer": "Corner Spore <71096603+sasha-thecornerspore-dev@users.noreply.github.com>",
      "artifactName": "The-Backrooms-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-512.png",
      "category": "public.app-category.games",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "The-Backrooms-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "sasha-thecornerspore-dev",
      "repo": "backrooms",
      "releaseType": "draft"
    }
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@5": {
      "brace-expansion": "^2.1.7"
    },
    "minimatch@9": {
      "brace-expansion": "^2.1.7"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.12"
    },
    "fast-uri": "^3.1.8",
    "http-cache-semantics": "^4.3.0",
    "js-yaml": "^4.3.2",
    "tar": "^7.5.22",
    "undici": "^6.28.1",
    "global-agent": {
      "roarr": "^4.2.5"
    }
  }
}
