{
  "name": "backrooms-relay",
  "main": "relay.js",
  "compatibility_date": "2025-06-01",
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": { "GITHUB_REPO": "sasha-thecornerspore-dev/backrooms" },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "GATE", "class_name": "Gate" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Gate"] }
  ]
}
